# =========================================================
# 🔧 Root-level .gitignore for combined frontend + backend
# =========================================================

# Node modules
college-app/node_modules
server/node_modules

# Build outputs
college-app/build

# Environment files
college-app/.env
server/.env

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs
tmp/
temp/

# IDE / OS specific
.DS_Store
Thumbs.db
.vscode/
.idea/

# Testing / coverage
coverage/
college-app/coverage
server/coverage

# Optional caches
college-app/.pnp
college-app/.pnp.js
college-app/.parcel-cache
server/.pnp
server/.pnp.js

# Misc
.env.local
.env.development.local
.env.test.local
.env.production.local
